# Server Configuration
PORT=8080

# External URLs Configuration
# For production deployment, set these to your actual domain
SERVER_URL=https://your-domain.com  # Used by client applications
SWAGGER_HOST=your-domain.com       # Used by Swagger documentation

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=speedtest_root_password
MYSQL_DATABASE=speedtest
MYSQL_USER=speedtest
MYSQL_PASSWORD=speedtest

# Database Connection URL (for application)
DATABASE_URL=speedtest:speedtest@tcp(localhost:3306)/speedtest?charset=utf8mb4&parseTime=True&loc=Local

# IPInfo.io API Token (optional, fallback token is provided)
IPINFO_TOKEN=20e16b08cd509a

# Rate Limiting Configuration
# Disable rate limiting for speed test endpoints to allow proper testing
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Optional: Set log level
LOG_LEVEL=info

# Optional: Enable debug mode
DEBUG=false

# JWT Secret for API authentication (generate a secure random string)
JWT_SECRET=your-super-secure-jwt-secret-here

# Demo API Key (hash of "demo-api-key-2025")
# Use X-API-Key: demo-api-key-2025 for testing API endpoints
DEMO_API_KEY_ENABLED=true

# Public API Key for web interface (used by HTML pages to save results)
# This key is safe to expose in frontend as it only has permission to save speed test results
PUBLIC_API_KEY=demo-api-key-2025
